# Backend
SECRET_KEY=change-me-to-a-long-random-string-in-production
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chatbot

# LLM Provider: groq | bytez | gemini | openrouter
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.1-8b-instant

# Alternative: Bytez
# LLM_PROVIDER=bytez
BYTEZ_API_KEY=your-bytez-api-key
BYTEZ_MODEL=Qwen/Qwen3-4B

# Alternative: Gemini
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-2.0-flash

# Alternative: OpenRouter
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-your-key
# OPENROUTER_MODEL=openai/gpt-4o-mini

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Upload settings
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
